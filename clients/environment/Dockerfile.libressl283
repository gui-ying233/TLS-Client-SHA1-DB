FROM debian:13
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential pkg-config wget xz-utils zlib1g-dev libbz2-dev \
    libffi-dev libsqlite3-dev libreadline-dev liblzma-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp/build
RUN curl -fsSLo libressl.tar.gz https://ftp.openbsd.org/pub/OpenBSD/LibreSSL/libressl-2.8.3.tar.gz && \
    tar -xzf libressl.tar.gz && cd libressl-2.8.3 && \
    ./configure --prefix=/opt/libressl283 && make -j2 && make install
RUN curl -fsSLo python.tar.xz https://www.python.org/ftp/python/3.9.6/Python-3.9.6.tar.xz && \
    tar -xf python.tar.xz && cd Python-3.9.6 && \
    ./configure --prefix=/opt/cpython --with-openssl=/opt/libressl283 && \
    make -j2 && make install
RUN /opt/cpython/bin/python3 -m pip install --disable-pip-version-check 'requests==2.32.5'
COPY probe.py /fpdb-probe.py
ENV PATH=/opt/cpython/bin:$PATH FPDB_IMAGE_LABEL=control-libressl283-cpython396
WORKDIR /
