          "{client_version}",
          "{endpoint}"
        ],
        "prepare": [
          "{python_bin}",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "requests=={client_version}"
        ]
      }
    },
