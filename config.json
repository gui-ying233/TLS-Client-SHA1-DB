{
  "schema_version": 1,
  "endpoint": "https://echo.yuaner.tw/",
  "sampling": {
    "initial_handshakes": 5,
    "expanded_handshakes": 10,
    "max_unique_per_field": 5,
    "max_combinations": 16,
    "timeout_seconds": 30,
    "retry_per_handshake": 1,
    "prepare_timeout_seconds": 1500
  },
  "execution": {
    "batch_size": 80,
    "active_runtime_count": 3,
    "max_matrix_size": 200
  },
  "profiles": {
    "incremental": {
      "enabled": true
    },
    "historical": {
      "enabled": true
    },
    "full": {
      "enabled": false
    }
  },
  "targets": [
    {
      "language": "python",
      "platform": "linux-x86_64",
      "runner": "ubuntu-24.04",
      "runtime_versions": {
        "type": "python_manifest",
        "url": "https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json",
        "platform": "linux",
        "platform_version": "24.04",
        "arch": "x64",
        "min_version": "3.8.0"
      },
      "enabled": true,
      "revision": "1",
      "id": "python-urllib",
      "client": "urllib",
      "client_versions": {
        "type": "static",
        "versions": [
          "stdlib"
        ]
      },
      "adapter": {
        "probe": [
          "{python_bin}",
          "clients/python/probe.py",
          "urllib",
          "{client_version}",
          "{endpoint}"
        ]
      }
    },
    {
