        "min_version": "2.20.0"
      },
      "adapter": {
        "probe": [
          "{python_bin}",
          "clients/python/probe.py",
          "requests",
          "{client_version}",
          "{endpoint}"
        ],
        "prepare": [
          "{python_bin}",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--no-input",
          "requests=={client_version}"
        ]
      },
      "compatibility": {
        "exclude": [
          {
            "runtime_max": "3.9.99",
            "client_min": "2.33.0"
          },
          {
            "runtime_min": "3.15.0",
            "client_max": "2.24.99"
          }
        ]
      }
    },
