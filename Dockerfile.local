# Local, non-GitHub-Actions collector. The checkout is mounted at runtime.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git openssl sudo util-linux \
    python3 python3-pip python3-venv python3-dev \
    build-essential pkg-config libssl-dev libcurl4-openssl-dev \
    perl xz-utils wget zlib1g-dev libffi-dev libsqlite3-dev \
    libbz2-dev liblzma-dev libreadline-dev \
    && python3 -m pip install --break-system-packages --no-cache-dir 'uv>=0.9,<1' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
ENTRYPOINT ["bash", "/repo/scripts/docker-entrypoint.sh"]
