# Local, non-GitHub-Actions collector. The checkout is mounted at runtime.
FROM ubuntu:24.04
COPY --from=ghcr.io/jdx/mise:2026.10.4 /usr/local/bin/mise /usr/local/bin/mise
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git openssl sudo util-linux \
    python3 python3-pip python3-venv python3-dev \
    build-essential pkg-config libssl-dev libcurl4-openssl-dev libpcre3-dev libpcre2-dev \
    perl xz-utils wget unzip zlib1g-dev libffi-dev libsqlite3-dev \
    libbz2-dev liblzma-dev libreadline-dev libyaml-dev libgdbm-dev \
    autoconf bison re2c cmake maven openjdk-21-jdk-headless ruby ruby-dev \
    php-cli php-curl php-xml php-mbstring composer libboost-dev \
    libio-socket-ssl-perl libjson-pp-perl libwww-perl liblwp-protocol-https-perl libwww-mechanize-perl \
    libxml2-dev libonig-dev libzip-dev libicu-dev libpng-dev libjpeg-dev \
    libfreetype6-dev libwebp-dev libgmp-dev libsodium-dev libncurses-dev libodbc2 \
    && python3 -m pip install --break-system-packages --no-cache-dir 'uv>=0.9,<1' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
# Match the side-by-side PHP versions used by setup-php on Ubuntu runners.
RUN apt-get update -qq && apt-get install -y --no-install-recommends gnupg \
    && curl -fsSL --retry 3 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xB8DC7E53946656EFBCE4C1DD71DAEAAB4AD4CAB6' \
       | gpg --dearmor -o /usr/share/keyrings/ondrej-php.gpg \
    && printf '%s\n' 'deb [signed-by=/usr/share/keyrings/ondrej-php.gpg] https://ppa.launchpadcontent.net/ondrej/php/ubuntu noble main' \
       > /etc/apt/sources.list.d/ondrej-php.list \
    && apt-get update -qq && apt-get install -y --no-install-recommends \
       php8.1-cli php8.1-curl php8.1-xml php8.1-mbstring \
       php8.2-cli php8.2-curl php8.2-xml php8.2-mbstring \
       php8.3-cli php8.3-curl php8.3-xml php8.3-mbstring \
       php8.4-cli php8.4-curl php8.4-xml php8.4-mbstring \
       php8.5-cli php8.5-curl php8.5-xml php8.5-mbstring \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV MISE_DATA_DIR=/cache/mise \
    MISE_INSTALLS_DIR=/cache/runtimes \
    MISE_CACHE_DIR=/cache/mise-cache \
    MISE_CONFIG_DIR=/cache/mise-config \
    MISE_STATE_DIR=/cache/mise-state \
    MISE_DOTNET_ROOT=/cache/dotnet \
    CARGO_HOME=/cache/cargo \
    RUSTUP_HOME=/cache/rustup
WORKDIR /repo
ENTRYPOINT ["bash", "/repo/scripts/docker-entrypoint.sh"]
